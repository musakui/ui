{
	"compilerOptions": {
		"strict": true,
		"noEmit": true,
		"allowJs": true,
		"target": "ESNext",
		"module": "ESNext",
		"skipLibCheck": true,
		"stripInternal": true,
		"isolatedModules": true,
		"moduleResolution": "node",
		"types": ["vite/client"],
		"lib": ["ESNext", "DOM", "DOM.Iterable"]
	},
	"include": [
		"test",
		"lib"
	]
}
