{
	"name": "@musakui/ui",
	"description": "web ui",
	"author": "musakui",
	"license": "MIT",
	"repository": {
		"url": "git+https://github.com/musakui/ui.git"
	},
	"version": "0.0.4",
	"type": "module",
	"files": [
		"types",
		"lib"
	],
	"main": "./lib/index.js",
	"types": "./types/index.d.ts",
	"imports": {
		"#_/*": "./src/*",
		"#/*": "./lib/*"
	},
	"exports": {
		"./signal": {
			"types": "./types/index.d.ts",
			"import": "./lib/signal/index.js"
		},
		"./tag": {
			"types": "./types/index.d.ts",
			"import": "./lib/tag/index.js"
		},
		"./api": {
			"types": "./types/index.d.ts",
			"import": "./lib/api/index.js"
		},
		"./idb": {
			"types": "./types/index.d.ts",
			"import": "./lib/idb/index.js"
		},
		"./router": {
			"types": "./types/index.d.ts",
			"import": "./lib/router/index.js"
		},
		".": {
			"types": "./types/index.d.ts",
			"import": "./lib/index.js"
		}
	},
	"scripts": {
		"test:coverage": "vitest --coverage",
		"test": "vitest",
		"dev": "vite"
	},
	"dependencies": {
	},
	"peerDependencies": {
		"alien-signals": "^3.2.0"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"@vitest/coverage-v8": "^4.1.0",
		"alien-signals": "^3.2.0",
		"happy-dom": "^20.9.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"tailwindcss": "^4.3.0",
		"typescript": "^6.0.0",
		"vite": "^8.0.0",
		"vitest": "^4.1.0"
	}
}
